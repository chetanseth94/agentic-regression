APP_NAME="Agentic Test Triage API"
APP_VERSION="0.1.0"
DEBUG="false"
LOG_LEVEL="INFO"

# Point this to the real STAF runtime base URL (keep this file sanitized)
AUTOMATION_API_BASE_URL="https://<your-staf-runtime-host>"

# TLS (corp clusters often require CA bundle)
# AUTOMATION_SSL_VERIFY="true"
# AUTOMATION_CA_BUNDLE_PATH="/path/to/corp-ca-bundle.pem"

# Polling defaults (Phase 1 guidance)
POLL_INTERVAL_SECONDS="60"
POLL_MAX_WAIT_SECONDS="1200"

# After activation, STAF /status may return nulls briefly.
# These control the grace window before we treat it as an error.
DIRECTORY_NOT_READY_MAX_WAIT_SECONDS="60"
DIRECTORY_NOT_READY_POLL_INTERVAL_SECONDS="5"

# Optional (Phase 3+)
# ANTHROPIC_API_KEY=""
# MCP_SERVER_URL=""
# JIRA_URL=""
# JIRA_EMAIL=""
# JIRA_API_TOKEN=""

